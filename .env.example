# Backend-only settings. Set the DeepSeek API key on the backend before using AI features.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
KNOWLEDGE_REPO_PATH=/workspace
DATABASE_PATH=/workspace/runtime/knowledge.db
KB_GIT_USER_NAME=KnowledgeBase
KB_GIT_USER_EMAIL=knowledgebase@localhost
KB_HTTP_BIND=127.0.0.1
KB_HTTP_PORT=8080
KB_IMPORT_DIRECTORY=./storage/uploads
KB_BACKUP_DIRECTORY=../KnowledgeBase-backups
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

APT_MIRROR=https://mirrors.aliyun.com

PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

NPM_REGISTRY=https://registry.npmmirror.com