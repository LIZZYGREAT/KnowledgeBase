# Backend-only defaults for the DeepSeek Gateway. A non-empty DEEPSEEK_MODEL
# overrides the configured model; the API key is read from the configured environment variable.
provider: deepseek
api_style: openai-chat-completions
base_url: https://api.deepseek.com
model: deepseek-flash
api_key_env: DEEPSEEK_API_KEY
timeout_seconds: 60
max_retries: 2
